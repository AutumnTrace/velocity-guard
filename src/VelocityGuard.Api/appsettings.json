{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Hosting": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://*:8080", "Protocols": "Http1AndHttp2" },
      "Grpc": { "Url": "http://*:8081", "Protocols": "Http2" }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Storage": {
    "Provider": "InMemory",
    "JournalRetention": "30.00:00:00"
  },
  "Redis": {
    "KeyPrefix": "vg",
    "OperationTimeout": "00:00:00.100",
    "ClientTimeout": "00:00:00.250",
    "BreakerFailureRatio": 0.5,
    "BreakerMinimumThroughput": 20,
    "BreakerSamplingDuration": "00:00:10",
    "BreakerBreakDuration": "00:00:15"
  },
  "Degraded": {
    "Policy": "Review"
  },
  "Cache": {
    "Expiration": "00:05:00",
    "LocalExpiration": "00:00:30"
  },
  "Outcomes": {
    "BlockOnChargeback": true,
    "ChargebackBlocklists": {
      "Card": "blocked-cards",
      "Device": "blocked-devices"
    }
  },
  "RiskData": {
    "SeedLists": {
      "blocked-devices": [ "dev-known-fraud-01" ],
      "trusted-players": [ "p-vip-0001" ]
    }
  },
  "Security": {
    "AdminApiKey": ""
  }
}
