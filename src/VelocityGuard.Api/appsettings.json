{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Hosting": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "InMemory",
    "JournalRetention": "30.00:00:00"
  },
  "Degraded": {
    "Policy": "Review"
  },
  "Cache": {
    "Expiration": "00:05:00",
    "LocalExpiration": "00:00:30"
  },
  "Outcomes": {
    "BlockOnChargeback": true,
    "ChargebackBlocklists": {
      "Card": "blocked-cards",
      "Device": "blocked-devices"
    }
  },
  "RiskData": {
    "SeedLists": {
      "blocked-devices": [ "dev-known-fraud-01" ],
      "trusted-players": [ "p-vip-0001" ]
    }
  },
  "Security": {
    "AdminApiKey": ""
  }
}
