{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "VelocityGuard": "Debug",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      }
    ]
  },
  "Security": {
    "AdminApiKey": "dev-admin-key-change-me"
  }
}
